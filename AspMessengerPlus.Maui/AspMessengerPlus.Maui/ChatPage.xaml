<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AspMessengerPlus.Maui.ChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:AspMessengerPlus.Maui.Converters"
    BackgroundColor="#0B1220"
    Title="Chat">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColor"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 顶部 -->
        <Grid BackgroundColor="#111C2E" Padding="16">
            <VerticalStackLayout Spacing="2">
                <Label Text="AspMessengerPlus"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"/>
                <Label Text="Online"
                       TextColor="#3B82F6"
                       FontSize="12"/>
            </VerticalStackLayout>
        </Grid>

        <!-- 消息列表 -->
        <CollectionView
            x:Name="MessagesView"
            Grid.Row="1"
            ItemsSource="{Binding Messages}"
            SelectionMode="None"
            Margin="12">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Grid Padding="6">

                        <HorizontalStackLayout
                HorizontalOptions="{Binding IsMine, Converter={StaticResource BoolToAlignment}}"
                Spacing="6">

                            <!-- 左头像 -->
                            <Image Source="{Binding Avatar}"
                       WidthRequest="36"
                       HeightRequest="36"
                       Aspect="AspectFill"
                       IsVisible="{Binding IsMine, Converter={StaticResource InverseBoolConverter}}"/>

                            <!-- 气泡 -->
                            <Frame Padding="12"
                       CornerRadius="20"
                       HasShadow="False"
                       MaximumWidthRequest="260"
                       BackgroundColor="{Binding IsMine, Converter={StaticResource BoolToColor}}">

                                <VerticalStackLayout Spacing="4">

                                    <Label Text="{Binding SenderName}"
                               FontSize="12"
                               TextColor="#9CA3AF"
                               IsVisible="{Binding IsMine, Converter={StaticResource InverseBoolConverter}}"/>

                                    <Label Text="{Binding Text}"
                               TextColor="White"
                               FontSize="16"
                               LineBreakMode="WordWrap"/>

                                    <HorizontalStackLayout HorizontalOptions="End"
                                               Spacing="4">

                                        <Label Text="{Binding FormattedTime}"
                                   FontSize="11"
                                   TextColor="#D1D5DB"/>

                                        <Label Text="{Binding ReadStatus}"
                                   FontSize="11"
                                   TextColor="#22C55E"/>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                            </Frame>

                            <!-- 右头像 -->
                            <Image Source="{Binding Avatar}"
                       WidthRequest="36"
                       HeightRequest="36"
                       Aspect="AspectFill"
                       IsVisible="{Binding IsMine}"/>

                        </HorizontalStackLayout>

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- 输入栏 -->
        <Grid Grid.Row="2"
              BackgroundColor="#111C2E"
              Padding="10"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">

            <Entry
                Grid.Column="0"
                Placeholder="Type a message..."
                Text="{Binding InputText}"
                BackgroundColor="#1E293B"
                TextColor="White"
                PlaceholderColor="#9CA3AF"
                Keyboard="Chat"
                HeightRequest="45"/>

            <Button
                Grid.Column="1"
                Text="➤"
                Command="{Binding SendCommand}"
                WidthRequest="45"
                HeightRequest="45"
                CornerRadius="22"
                BackgroundColor="#2563EB"
                TextColor="White"/>

        </Grid>

    </Grid>
</ContentPage>
