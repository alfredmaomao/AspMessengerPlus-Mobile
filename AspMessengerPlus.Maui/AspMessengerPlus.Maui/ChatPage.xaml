<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AspMessengerPlus.Maui.ChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:AspMessengerPlus.Maui.Converters"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#0B1220">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColor"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="60,*,Auto">

        <!-- iMessage 风格顶部 -->
        <Grid BackgroundColor="#0B1220"
              Padding="12,0"
              HeightRequest="60">

            <HorizontalStackLayout VerticalOptions="Center"
                                   Spacing="10">

                <Label Text="←"
                       FontSize="20"
                       TextColor="White">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <VerticalStackLayout Spacing="0">

                    <Label Text="AspMessengerPlus"
                           TextColor="White"
                           FontSize="17"
                           FontAttributes="Bold"/>

                    <Label Text="{Binding TypingText}"
                        TextColor="#3B82F6"
                        FontSize="11"/>

                </VerticalStackLayout>

            </HorizontalStackLayout>
        </Grid>

        <!-- 消息列表 -->
        <CollectionView
            x:Name="MessagesView"
            Grid.Row="1"
            ItemsSource="{Binding Messages}"
            SelectionMode="None"
            Margin="14">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Grid Padding="6">

                        <HorizontalStackLayout
                            HorizontalOptions="{Binding IsMine, Converter={StaticResource BoolToAlignment}}"
                            Spacing="8">

                            <!-- 左头像 -->
                            <Frame Padding="0"
                                   CornerRadius="18"
                                   HeightRequest="36"
                                   WidthRequest="36"
                                   IsVisible="{Binding IsMine, Converter={StaticResource InverseBoolConverter}}"
                                   HasShadow="False">

                                <Image Source="{Binding Avatar}"
                                       Aspect="AspectFill"/>
                            </Frame>

                            <!-- 气泡 -->
                            <Frame Padding="14"
       CornerRadius="22"
       HasShadow="True"
       MaximumWidthRequest="270"
       BackgroundColor="{Binding IsMine, Converter={StaticResource BoolToColor}}">

                                <VerticalStackLayout Spacing="6">

                                    <!-- 正常消息 -->
                                    <Label Text="{Binding Text}"
               TextColor="White"
               FontSize="16"
               LineBreakMode="WordWrap"
               IsVisible="{Binding IsTyping, Converter={StaticResource InverseBoolConverter}}"/>

                                    <!-- Typing 动画（三个点） -->
                                    <HorizontalStackLayout IsVisible="{Binding IsTyping}"
                               Spacing="6"
                               HorizontalOptions="Start">

                                        <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="White"/>
                                        <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="White"/>
                                        <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="White"/>

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Frame>


                            <!-- 右头像 -->
                            <Frame Padding="0"
                                   CornerRadius="18"
                                   HeightRequest="36"
                                   WidthRequest="36"
                                   IsVisible="{Binding IsMine}"
                                   HasShadow="False">

                                <Image Source="{Binding Avatar}"
                                       Aspect="AspectFill"/>
                            </Frame>

                        </HorizontalStackLayout>

                    </Grid>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- 输入栏 -->
        <Grid Grid.Row="2"
              BackgroundColor="#0B1220"
              Padding="12"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">

            <Frame Grid.Column="0"
                   BackgroundColor="#1E293B"
                   CornerRadius="24"
                   Padding="10"
                   HasShadow="False">

                <Entry Placeholder="Type a message..."
                       Text="{Binding InputText}"
                       TextColor="White"
                       PlaceholderColor="#9CA3AF"
                       BackgroundColor="Transparent"
                       Keyboard="Chat"/>
            </Frame>

            <Button Grid.Column="1"
                    Text="➤"
                    Command="{Binding SendCommand}"
                    WidthRequest="46"
                    HeightRequest="46"
                    CornerRadius="23"
                    BackgroundColor="#2563EB"
                    TextColor="White"/>
        </Grid>

    </Grid>
</ContentPage>
