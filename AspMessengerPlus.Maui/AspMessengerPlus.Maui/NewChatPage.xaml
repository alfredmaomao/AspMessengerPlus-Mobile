<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AspMessengerPlus.Maui.NewChatPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="New Chat">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0B1220" Offset="0.0"/>
            <GradientStop Color="#111827" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*">

        <!-- 顶部标题 -->
        <Grid Padding="16"
              BackgroundColor="#1E293B">

            <HorizontalStackLayout VerticalOptions="Center">

                <Label Text="Start New Chat"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="StartAndExpand"/>

            </HorizontalStackLayout>
        </Grid>

        <!-- 用户列表 -->
        <CollectionView
            x:Name="UsersView"
            Grid.Row="1"
            Margin="12"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        StrokeThickness="0"
                        BackgroundColor="#1E293B"
                        Padding="14"
                        Margin="0,6"
                        StrokeShape="RoundRectangle 20">

                        <Grid ColumnDefinitions="50,*,Auto">

                            <!-- 圆形头像 -->
                            <Grid WidthRequest="40"
                                  HeightRequest="40">

                                <Ellipse Fill="#2563EB"/>

                                <Label Text="{Binding Username}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       LineBreakMode="NoWrap"/>
                            </Grid>

                            <!-- 用户名 -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 Padding="10,0">

                                <Label Text="{Binding Username}"
                                       TextColor="White"
                                       FontSize="16"
                                       FontAttributes="Bold"/>

                                <Label Text="Tap to start chatting"
                                       FontSize="12"
                                       TextColor="#9CA3AF"/>
                            </VerticalStackLayout>

                            <!-- 箭头 -->
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="22"
                                   VerticalOptions="Center"
                                   TextColor="#6B7280"/>

                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUserTapped"/>
                        </Border.GestureRecognizers>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
